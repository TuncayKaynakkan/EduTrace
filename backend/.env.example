# Gemini API key for educational threat reports
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Threat intelligence needs no key: Spamhaus DROP and Feodo Tracker lists are
# downloaded every 12 hours and checked locally.

# Server configuration (default: only this machine)
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
# CORS_ORIGINS=

# Automatic firewall blocking and process termination are EduTrace Pro settings
# in the panel (Pro Ayarlari -> Otomatik Mudahale), off by default.
