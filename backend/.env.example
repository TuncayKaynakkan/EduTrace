# Gemini API key for educational threat reports
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Threat intelligence needs no key: Spamhaus DROP and Feodo Tracker lists are
# downloaded every 12 hours and checked locally.

# Server configuration (default: only this machine)
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
# CORS_ORIGINS=

# Safety switches
# Add a Windows Firewall block rule for malicious public IPs (needs administrator)
FIREWALL_BLOCK=true
# Terminate the suspicious process automatically (off by default)
AUTO_TERMINATE=false
